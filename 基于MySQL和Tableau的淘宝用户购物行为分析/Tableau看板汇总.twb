          <formatted-text>
            <run fontcolor='#000000' fontname='Microsoft YaHei'>每日PV/UV趋势与成交率变化</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='taobao' name='federated.0eaj1u411ih72a1atkrkf1lofklm' />
            <datasource caption='参数' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
